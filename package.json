{
  "name": "aiwa-v2",
  "version": "2.0.0",
  "private": true,
  "description": "AI Sales WhatsApp - Multi-Tenant Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "npm run build --workspaces",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run migrate --workspace=@aiwa/db",
    "db:seed": "npm run seed --workspace=@aiwa/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "playwright": "node apps/playwright-service/server.js"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
